# Copia questo file in .env (locale) o imposta le stesse variabili come
# variabili d'ambiente nel servizio Koyeb. Non inserire mai credenziali reali
# in questo file di esempio.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSLMODE=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
